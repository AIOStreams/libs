     }
 
+    size_t key_offs = CACHE_ITEM_SIZE + align_cache(desc->value_size);
     item = malloc(key_offs + desc->key_size);
     if (!item) {
         desc->key_move_func(NULL, key);
         return NULL;
     }
-    item->cache = cache;
-    item->desc = desc;
     void *new_key = (char *) item + key_offs;
