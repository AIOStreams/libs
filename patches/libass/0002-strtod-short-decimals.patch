From c2d1ae37d91cc261cefec0f7ff63636454d75024 Mon Sep 17 00:00:00 2001
From: Viren070 <viren070@protonmail.com>
Date: Wed, 21 Oct 2026 22:28:36 +0100
Subject: [PATCH] ass_strtod: divide short decimals directly

Tag values are nearly always short decimals, for which one division by an
exact power of ten is already correctly rounded.
---
 libass/ass_strtod.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/libass/ass_strtod.c b/libass/ass_strtod.c
index 47302a8..cc95edf 100644
--- a/libass/ass_strtod.c
+++ b/libass/ass_strtod.c
@@ -41,6 +41,12 @@ const double powersOf10[] = {   /* Table giving binary powers of 10.  Entry */
     1.0e256
 };
 
+static
+const double exactPowersOf10[] = {
+    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
+    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
+};
+
 static
 const double negPowOf10[] = {   /* Table giving negative binary powers */
     0.1,                        /* of 10.  Entry is 10^-2^i. */
@@ -133,6 +139,40 @@ ass_strtod(
         sign = 0;
     }
 
+    /*
+     * Up to nine significant digits and no exponent: frac1 below stays 0
+     * and 10^n is exact up to 10^22, so this one division is the result
+     * the general path computes.
+     */
+    {
+        const char *q = p;
+        unsigned value = 0;
+        int digits = 0, significant = 0, decimals = 0, point = 0;
+        for (;; q++) {
+            c = *q;
+            if (ass_isdigit(c)) {
+                digits++;
+                decimals += point;
+                if (value || c != '0') {
+                    if (++significant > 9)
+                        break;
+                    value = value * 10 + (c - '0');
+                }
+            } else if (c == '.' && !point) {
+                point = 1;
+            } else {
+                break;
+            }
+        }
+        if (digits && significant <= 9 && decimals <= 22 && c != 'e' && c != 'E') {
+            fraction = decimals ? value / exactPowersOf10[decimals] : value;
+            if (endPtr != NULL) {
+                *endPtr = (char *) q;
+            }
+            return sign ? -fraction : fraction;
+        }
+    }
+
     /*
      * Count the number of digits in the mantissa (including the decimal
      * point), and also locate the decimal point.
-- 
