From 0c2efad27655338680fab70b30262dd6bf467d4f Mon Sep 17 00:00:00 2001
From: Viren070 <viren070@protonmail.com>
Date: Mon, 19 Oct 2026 20:33:18 +0100
Subject: [PATCH] avcodec/hevc/refs: don't generate the missing references of
 an IRAP picture whose RASL pictures are skipped

Only RASL pictures may use them, so they were allocated and filled only to
be dropped, a whole frame each when decoding starts at an open-GOP keyframe.
---
 libavcodec/hevc/refs.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libavcodec/hevc/refs.c b/libavcodec/hevc/refs.c
index 84418d2..b63bfbf 100644
--- a/libavcodec/hevc/refs.c
+++ b/libavcodec/hevc/refs.c
@@ -521,6 +521,9 @@ static int add_candidate_ref(HEVCContext *s, HEVCLayerContext *l,
     }
 
     if (!ref) {
+        /* Only RASL pictures, which are skipped here, may use them. */
+        if (IS_IRAP(s) && s->no_rasl_output_flag)
+            return 0;
         ref = generate_missing_ref(s, l, poc);
         if (!ref)
             return AVERROR(ENOMEM);
-- 
2.43.0

