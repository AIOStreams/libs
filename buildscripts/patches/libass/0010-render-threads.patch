+int ass_set_threads(ASS_Renderer *priv, int threads)
+{
+    if (threads <= 0)
+        threads = ass_default_threads();
+    if (threads != priv->settings.threads) {
+        ass_render_pool_free(priv->pool);
+        priv->pool = NULL;
+        priv->settings.threads = threads;
+    }
+    return threads;
+}
+
